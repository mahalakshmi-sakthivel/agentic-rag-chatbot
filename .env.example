# ─────────────────────────────────────────────────────────────────────────────
# .env.example  —  Copy to .env and fill in real values before starting the server.
#
# NEVER commit the .env file to source control.
# Add .env to .gitignore immediately.
# ─────────────────────────────────────────────────────────────────────────────

# JWT signing secret (HMAC-SHA256).
# Must be at least 32 random characters. Generate with:
#   openssl rand -hex 32
JWT_SECRET=CHANGE_ME_use_a_strong_random_secret_at_least_32_chars

# Token claims
JWT_ISSUER=agentic-rag-chatbot
JWT_AUDIENCE=chatbot-api

# Access-token lifetime in seconds (default: 3600 = 1 hour)
TOKEN_EXPIRY_SECONDS=3600

# SQLite database file path
DB_PATH=./data/chatbot.db

# Server bind address and port
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
