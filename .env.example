# Internal auth — shared secret with Phase 5 (§19A.6). Generate a real
# random value for any shared/staging/production environment; never commit
# the real value.
INTERNAL_SERVICE_TOKEN=change-me-to-a-random-secret

# LLM provider: "ollama" (local Qwen3 8B), "openai_compatible", or "mock"
LLM_PROVIDER=ollama
LLM_MODEL_NAME=qwen3:8b
LLM_BASE_URL=http://host.docker.internal:11434
LLM_TIMEOUT_MS=8000
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=500
LLM_API_KEY=

# Token / context-window budgeting
MAX_CONTEXT_TOKENS=6000
MAX_CHUNKS_IN_PROMPT=20

# Validation
MIN_CITATION_COVERAGE=0.6
ALLOW_REGENERATION=true
