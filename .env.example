# ---- Phase 1 owned variables (per PHASE_1_CONTRACT.md Section 13) ----

# Port the C++ REST API listens on
BACKEND_PORT=8080

# Where uploaded files are written to disk (Phase 3's ingestion pipeline reads from here)
FILE_STORAGE_PATH=./storage/uploads

# Logging verbosity: debug | info
LOG_LEVEL=info

# development | staging | production
ENVIRONMENT=development

# Open Decision #15 (parent Section 31) — TBD, defaulted to 50MB here.
# Confirm the final value with the team and update this default.
MAX_UPLOAD_SIZE_MB=50

# DEV-ONLY auth bypass (see backend/src/common/identity.h). When true, a
# request with `Authorization: Bearer dev-local-only` is treated as
# authenticated so /v1/query and /v1/data/upload can be tested locally
# before Phase 2's real JWT verifier exists.
# MUST be false (the default) in any shared/staging/production environment
# — Section 19.1 requires all non-health/login endpoints to require real
# authentication there.
AUTH_DEV_BYPASS=false
