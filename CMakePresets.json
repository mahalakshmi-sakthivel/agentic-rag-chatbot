{
  "version": 6,
  "configurePresets": [
    {
      "name": "apt",
      "displayName": "apt-installed dependencies (Ubuntu/Debian)",
      "description": "Use when Drogon/nlohmann-json/gtest are installed via apt (see README section 1).",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "vcpkg",
      "displayName": "vcpkg-managed dependencies",
      "description": "Use with VCPKG_ROOT set in the environment (matches vcpkg.json's pinned builtin-baseline).",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug build (apt dependencies)",
      "inherits": "apt",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    { "name": "apt", "configurePreset": "apt" },
    { "name": "vcpkg", "configurePreset": "vcpkg" },
    { "name": "debug", "configurePreset": "debug" }
  ],
  "testPresets": [
    { "name": "apt", "configurePreset": "apt", "output": { "outputOnFailure": true } },
    { "name": "vcpkg", "configurePreset": "vcpkg", "output": { "outputOnFailure": true } }
  ]
}
